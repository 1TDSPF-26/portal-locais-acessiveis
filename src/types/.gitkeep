export interface Endereco {
  rua?: string;
  numero?: string;
  cidade?: string;
  estado?: string;
}
export interface Coordenadas {
  latitude: number;
  longitude: number;
}

export interface Acessibilidade {
  status: 'acessivel' | 'parcial' | 'nao_acessivel' | 'nao_informado';
  descricao?: string;
}
export interface Local {
  id: string;
  nome: string;
  descricao?: string;
  categoria: string;
  imagem?: string;
}
